#PlayerHPBar .unity-progress-bar__background {
    background-color: rgb(40, 40, 40);
}

#PlayerHPBar .unity-progress-bar__progress {
    background-image: none;
    background-color: rgb(160, 32, 240);
}

#PlayerHPBar .unity-progress-bar__title {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 12px;
}

#GoldGroup {
    flex-direction: row;
    align-items: center;
    position: absolute;
    right: 20px;
    bottom: 20px;
}

#GoldGroup #GoldImage{
    width: 27px;
    height: 21px;
    flex-shrink: 0;
}

#GoldGroup #GoldValue{
    margin-right: 6px;
    -unity-text-align: middle-right;
    color: rgb(255, 255, 255);
    font-size: 14px;
}


